# Server
PORT=4000
HOST=0.0.0.0

# Creator info: store a bcrypt hash here (see README pour générer)
CREATOR_INFO_HASHED_PW=

# Optional public info (non-sensitive) can live in env or DB
CREATOR_NAME=Nom Exemple
CREATOR_BIO=Bio publique

# Storage
USE_S3=false
S3_BUCKET=
S3_REGION=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google Vision (optional, for better OCR)
GOOGLE_APPLICATION_CREDENTIALS=

# Redis for scale (optional)
REDIS_URL=

# Prisma / Database
DATABASE_URL=file:./dev.db
